[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
macos.debug = "res://rust/target/release/libdofus_vello_godot.dylib"
macos.release = "res://rust/target/release/libdofus_vello_godot.dylib"
linux.debug.x86_64 = "res://rust/target/debug/libdofus_vello_godot.so"
linux.release.x86_64 = "res://rust/target/release/libdofus_vello_godot.so"
windows.debug.x86_64 = "res://rust/target/release/dofus_vello_godot.dll"
windows.release.x86_64 = "res://rust/target/release/dofus_vello_godot.dll"
